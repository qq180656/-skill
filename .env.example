# BlueAI 网关 API Key —— 本机设为环境变量,不要把真实值提交进仓库。
#
# Windows(cmd/powershell,设完重开终端生效):
#   setx BLUEAI_GW_KEYS  "blueai-视频key1,blueai-视频key2,blueai-视频key3"
#   setx BLUEAI_LLM_KEYS "blueai-断句key1,blueai-断句key2,blueai-断句key3"
#
# 逗号分隔多把 key:
#   BLUEAI_GW_KEYS  = 视频生成(Seedance)池,对应 config_matrix 的蚂蚁保/爱奇艺/游戏三把
#   BLUEAI_LLM_KEYS = LLM 断句(relay)池
#
# scripts/skill_config.py 与 image_to_video.py 会从这两个环境变量读取。

BLUEAI_GW_KEYS=blueai-xxxxxxxx,blueai-yyyyyyyy,blueai-zzzzzzzz
BLUEAI_LLM_KEYS=blueai-aaaaaaaa,blueai-bbbbbbbb,blueai-cccccccc
